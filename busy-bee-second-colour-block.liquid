<style>.nyr-vp{margin:12px 0 14px}.nyr-vp-h{font-size:13px;font-weight:600;color:#000;margin:0 0 8px}.nyr-vp-row{margin:0 0 12px}.nyr-vp-item{font-size:12px;font-weight:600;color:#000;margin:0 0 6px}.nyr-vp-g{display:grid;grid-template-columns:1fr 1fr;gap:8px}.nyr-vp-o{display:flex;align-items:center;gap:8px;width:100%;border:1px solid #d9dcea;border-radius:4px;padding:8px 9px;background:#fff;cursor:pointer;font-size:12px;color:#000;text-align:left;font-family:inherit}.nyr-vp-o.on{border:1.5px solid #6c7ba2}.nyr-vp-c{width:18px;height:18px;border-radius:3px;flex:0 0 18px;border:1px solid rgba(0,0,0,.12)}.nyr-vp-t{margin-left:auto;font-size:9px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:#6c7ba2}.product-form__input--swatch,.product-form__input:has(>fieldset.product-form__input--swatch){display:none!important}body.nyr-multi .shopify-payment-button{display:none!important}.nyr-vp-clr{display:block;width:100%;margin:8px 0 0;padding:5px 8px;border:1px solid #000;border-radius:4px;background:#fff;color:#000;font-size:11px;font-weight:600;font-family:inherit;cursor:pointer;text-align:center}.nyr-sb{position:fixed;left:0;right:0;bottom:0;z-index:40;display:none;align-items:center;gap:10px;background:#fff;padding:10px 14px calc(10px + env(safe-area-inset-bottom));box-shadow:0 -4px 16px rgba(0,0,0,.12)}.nyr-sb.show{display:flex}.nyr-sb-t{flex:1 1 auto;min-width:0;font-size:12px;font-weight:700;color:#000;line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.nyr-sb-b{flex:0 0 auto;background:#6c7ba2;color:#fff;border:0;padding:12px 18px;font-size:13px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;font-family:inherit;cursor:pointer}@media(min-width:750px){.nyr-sb,.nyr-sb.show{display:none}}</style><div class="nyr-vp" id="nyrVp"></div>{%- assign nyr_hive = all_products['digital-product-1'].selected_or_first_available_variant -%}<script>window.nyrHive={%- if nyr_hive.available -%}{{ nyr_hive.id }}{%- else -%}0{%- endif -%};</script><script>window.nyrVars={ {% for v in product.variants %}"{{ v.option1 | escape }}":{{ v.id }}{% unless forloop.last %},{% endunless %}{% endfor %} };</script><script>(function(){if(window.__nyrVp7)return;window.__nyrVp7=1;function nyrLock(b){b.setAttribute('aria-disabled','true');b.classList.add('loading');var t=b.querySelector('span');if(t&&!t.getAttribute('data-t')){t.setAttribute('data-t',t.textContent);t.textContent='Going to checkout…'}}function nyrUnlock(){window.__nyrBusy=0;var bs=document.querySelectorAll('button[name="add"]');for(var j=0;j<bs.length;j++){var b=bs[j];b.removeAttribute('aria-disabled');b.classList.remove('loading');var t=b.querySelector('span');if(t&&t.getAttribute('data-t')){t.textContent=t.getAttribute('data-t');t.removeAttribute('data-t')}}}window.addEventListener('pageshow',nyrUnlock);var C={'Blue':'#2F5FD0','Pink':'#F4A7C0','Blue Premium':'#1B2A6B','Pink Premium':'#C2185B'};window.nyrBogo={'Blue':71318400204913,'Pink':71318400237681,'Blue Premium':71318400270449,'Pink Premium':71318400303217};var names=Object.keys(window.nyrVars);var box=document.getElementById('nyrVp');var picks=[0,-1,-1];var rendered='';var lastBogo=false;function fs(){return document.querySelector('fieldset.product-form__input--swatch')}function qty(){var r=document.querySelector('input[name="quantity"]:checked');var n=r?+r.value:1;return Math.max(1,Math.min(3,n))}function bogo(){return qty()===1}function slots(){return bogo()?2:qty()}function key(){return slots()+'|'+bogo()}function picked(){var c=0;for(var i=0;i<slots();i++){if(picks[i]>=0)c++}return c}function setNative(k){var f=fs();if(!f)return;var inps=f.querySelectorAll('input');for(var i=0;i<inps.length;i++){if(inps[i].value===names[k]){if(!inps[i].checked){var lab=f.querySelector('label[for="'+inps[i].id+'"]');if(lab)lab.click()}break}}}function card(i,k){var n=names[k];var prem=/Premium/.test(n);return '<button type="button" class="nyr-vp-o'+(picks[i]===k?' on':'')+'" data-item="'+i+'" data-k="'+k+'"><span class="nyr-vp-c" style="background:'+(C[n]||'#ccc')+'"></span>'+n.replace(' Premium','')+(prem?'<span class="nyr-vp-t">Premium</span>':'')+'</button>'}function render(){var n=slots();var bg=bogo();if(bg&&!lastBogo){picks[1]=-1}lastBogo=bg;var h='';for(var i=0;i<n;i++){if(!(bg&&i===1)&&picks[i]<0){picks[i]=0}var head;if(bg){head=(i===1)?'<div class="nyr-vp-h">Would you like a second one for 50% off? (Optional)</div>':'<div class="nyr-vp-h">Color</div>'}else if(n>1){head='<div class="nyr-vp-item">Item '+(i+1)+' colour</div>'}else{head='<div class="nyr-vp-h">Color</div>'}h+='<div class="nyr-vp-row">'+head+'<div class="nyr-vp-g">'+names.map(function(nm,k){return card(i,k)}).join('')+'</div>'+((bg&&i===1)?'<button type="button" class="nyr-vp-clr">Clear options</button>':'')+'</div>'}box.innerHTML=h;document.body.classList.toggle('nyr-multi',n>1||picked()>1);rendered=key()}box.addEventListener('click',function(e){if(e.target.closest&&e.target.closest('.nyr-vp-clr')){picks[1]=-1;render();return}var t=e.target.closest?e.target.closest('.nyr-vp-o'):null;if(!t)return;var i=+t.getAttribute('data-item'),k=+t.getAttribute('data-k');if(bogo()&&i===1&&picks[1]===k){picks[1]=-1}else{picks[i]=k}if(i===0)setNative(k);render()});document.addEventListener('change',function(e){if(e.target&&e.target.name==='quantity')render()});document.addEventListener('click',function(e){var btn=e.target.closest?e.target.closest('button[name="add"]'):null;if(!btn)return;var n=qty();var extra=bogo()&&picks[1]>=0;var ao=document.getElementById('nyrAddon');var aoOn=ao&&ao.checked&&ao.getAttribute('data-variant');e.preventDefault();e.stopImmediatePropagation();if(window.__nyrBusy)return;window.__nyrBusy=1;nyrLock(btn);var items=[];var s=slots();for(var i=0;i<s;i++){if(picks[i]>=0){items.push({id:(bogo()&&i===1)?window.nyrBogo[names[picks[i]]]:window.nyrVars[names[picks[i]]],quantity:1})}}if(aoOn){items.push({id:+aoOn,quantity:1})}function addAll(){return fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:items})}).then(function(r){location.href=r.ok?'/checkout':'/cart'}).catch(function(){location.href='/cart'})}var hv=window.nyrHive;if(!hv){addAll();return}fetch('/cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json()}).then(function(c){var has=(c.items||[]).some(function(it){return it.variant_id===hv});if(!has){items.push({id:hv,quantity:1})}addAll()}).catch(function(){addAll()})},true);render();setInterval(function(){var f=fs();if(f)f.style.display='none';if(key()!==rendered)render()},400)})();</script><div class="nyr-sb" id="nyrSb" aria-hidden="true"><span class="nyr-sb-t">{{ product.title | escape }}</span><button type="button" class="nyr-sb-b" id="nyrSbBtn">Checkout</button></div><script>(function(){var bar=document.getElementById('nyrSb');if(!bar||bar.__ok)return;bar.__ok=1;document.body.appendChild(bar);function main(){var bs=document.querySelectorAll('button[name="add"]');return bs.length?bs[0]:null}document.getElementById('nyrSbBtn').addEventListener('click',function(){var m=main();if(m)m.click()});var tries=0;function watch(){var m=main();if(!m){if(++tries<40)setTimeout(watch,250);return}if(!('IntersectionObserver' in window))return;new IntersectionObserver(function(en){var off=!en[0].isIntersecting;bar.classList.toggle('show',off);bar.setAttribute('aria-hidden',off?'false':'true')}).observe(m)}watch()})();</script>
