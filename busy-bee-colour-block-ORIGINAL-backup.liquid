<style>.nyr-vp{margin:12px 0 14px}.nyr-vp-h{font-size:13px;font-weight:600;color:#000;margin:0 0 8px}.nyr-vp-row{margin:0 0 12px}.nyr-vp-item{font-size:12px;font-weight:600;color:#000;margin:0 0 6px}.nyr-vp-g{display:grid;grid-template-columns:1fr 1fr;gap:8px}.nyr-vp-o{display:flex;align-items:center;gap:8px;width:100%;border:1px solid #d9dcea;border-radius:4px;padding:8px 9px;background:#fff;cursor:pointer;font-size:12px;color:#000;text-align:left;font-family:inherit}.nyr-vp-o.on{border:1.5px solid #6c7ba2}.nyr-vp-c{width:18px;height:18px;border-radius:3px;flex:0 0 18px;border:1px solid rgba(0,0,0,.12)}.nyr-vp-t{margin-left:auto;font-size:9px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:#6c7ba2}.product-form__input--swatch,.product-form__input:has(>fieldset.product-form__input--swatch){display:none!important}body.nyr-multi .shopify-payment-button{display:none!important}</style><div class="nyr-vp" id="nyrVp"></div><script>window.nyrVars={ {% for v in product.variants %}"{{ v.option1 | escape }}":{{ v.id }}{% unless forloop.last %},{% endunless %}{% endfor %} };</script><script>(function(){if(window.__nyrVp2)return;window.__nyrVp2=1;var C={'Blue':'#2F5FD0','Pink':'#F4A7C0','Blue Premium':'#1B2A6B','Pink Premium':'#C2185B'};var names=Object.keys(window.nyrVars);var box=document.getElementById('nyrVp');var picks=[0,0,0];var rendered=-1;function fs(){return document.querySelector('fieldset.product-form__input--swatch')}function qty(){var r=document.querySelector('input[name="quantity"]:checked');var n=r?+r.value:1;return Math.max(1,Math.min(3,n))}function setNative(k){var f=fs();if(!f)return;var inps=f.querySelectorAll('input');for(var i=0;i<inps.length;i++){if(inps[i].value===names[k]){if(!inps[i].checked){var lab=f.querySelector('label[for="'+inps[i].id+'"]');if(lab)lab.click()}break}}}function card(i,k){var n=names[k];var prem=/Premium/.test(n);return '<button type="button" class="nyr-vp-o'+(picks[i]===k?' on':'')+'" data-item="'+i+'" data-k="'+k+'"><span class="nyr-vp-c" style="background:'+(C[n]||'#ccc')+'"></span>'+n.replace(' Premium','')+(prem?'<span class="nyr-vp-t">Premium</span>':'')+'</button>'}function render(){var n=qty();var h='';for(var i=0;i<n;i++){h+='<div class="nyr-vp-row">'+(n>1?'<div class="nyr-vp-item">Item '+(i+1)+' colour</div>':'<div class="nyr-vp-h">Color</div>')+'<div class="nyr-vp-g">'+names.map(function(nm,k){return card(i,k)}).join('')+'</div></div>'}box.innerHTML=h;document.body.classList.toggle('nyr-multi',n>1);rendered=n}box.addEventListener('click',function(e){var b=e.target.closest?e.target.closest('.nyr-vp-o'):null;if(!b)return;var i=+b.getAttribute('data-item'),k=+b.getAttribute('data-k');picks[i]=k;if(i===0)setNative(k);render()});document.addEventListener('change',function(e){if(e.target&&e.target.name==='quantity')render()});document.addEventListener('click',function(e){var b=e.target.closest?e.target.closest('button[name="add"]'):null;if(!b)return;var n=qty();if(n<=1)return;e.preventDefault();e.stopImmediatePropagation();var items=[];for(var i=0;i<n;i++){items.push({id:window.nyrVars[names[picks[i]]],quantity:1})}fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:items})}).then(function(){location.href='/checkout'},function(){location.href='/cart'})},true);render();setInterval(function(){var f=fs();if(f)f.style.display='none';if(qty()!==rendered)render()},400)})();</script>
