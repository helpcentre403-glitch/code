{%- comment -%} Paste the sale image URL from Shopify Files between the quotes below. Leave empty to show the text version instead. {%- endcomment -%}
{%- assign bf_img = 'https://cdn.shopify.com/s/files/1/0633/8307/6977/files/Screenshot_2026-11-25_at_3.17.07PM.png?v=1795641466' -%}
{%- assign bf_gift = all_products['digital-product-1'] -%}
<style>
.nyr-bf{font-family:var(--font-heading-family);position:relative;background:#fff;border-radius:18px;padding:20px 20px 22px;margin:16px 0 18px;box-shadow:0 6px 22px rgba(108,123,162,.14);border:1px solid #edf0f7;color:#222;overflow:hidden}
.nyr-bf-top{display:flex;align-items:center;justify-content:space-between;gap:8px}
.nyr-bf-title{font-family:var(--font-heading-family);font-size:30px;font-weight:800;line-height:1.08;margin:0;color:#3a3a3a;letter-spacing:-.01em}
.nyr-bf-off{display:flex;align-items:center;gap:4px;flex:0 0 auto}
.nyr-bf-upto{font-family:var(--font-heading-family);font-size:26px;font-weight:800;color:#6c7ba2;letter-spacing:.02em;white-space:nowrap;line-height:1}
.nyr-bf-off img{display:block;width:140px;height:auto;margin:0;mix-blend-mode:multiply}
.nyr-bf-off b{font-size:40px;font-weight:800;color:#6c7ba2;line-height:1}
.nyr-bf-gift{display:flex;align-items:center;gap:12px;margin:14px 0 16px}
.nyr-bf-gift-img{flex:0 0 54px;width:54px;height:54px;border-radius:10px;overflow:hidden;background:#f2f4fa;display:flex;align-items:center;justify-content:center;font-size:28px}
.nyr-bf-gift-img img{width:100%;height:100%;object-fit:cover;display:block}
.nyr-bf-perk{font-family:var(--font-heading-family);font-size:18px;font-weight:800;color:#6c7ba2;margin:0 0 4px}
.nyr-bf-line{font-size:14px;line-height:1.45;margin:0;color:#222;letter-spacing:.01em}
.nyr-bf-timer{display:flex;gap:10px;padding-bottom:4px}
.nyr-bf-box{background:linear-gradient(180deg,#8594b9 0%,#6c7ba2 100%);color:#fff;border-radius:10px;width:64px;padding:9px 0 7px;text-align:center;box-shadow:0 4px 0 #535f82,0 8px 14px rgba(83,95,130,.35);text-shadow:0 2px 2px rgba(0,0,0,.22)}
.nyr-bf-box b{display:block;font-family:var(--font-heading-family);font-size:28px;font-weight:800;line-height:1}
.nyr-bf-box span{display:block;font-size:10px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;margin-top:4px;opacity:.95}
@media(max-width:480px){
.nyr-bf{padding:16px 16px 18px}
.nyr-bf-title{font-size:24px;white-space:nowrap}
.nyr-bf-off{flex-direction:column;align-items:center;gap:2px}
.nyr-bf-upto{font-size:18px}
.nyr-bf-off img{width:110px}
.nyr-bf-off b{font-size:32px}
.nyr-bf-perk{font-size:16px}
.nyr-bf-line{font-size:13px}
.nyr-bf-timer{gap:8px}
.nyr-bf-box{width:58px}
.nyr-bf-box b{font-size:24px}
}
</style>
<div class="nyr-bf" data-end="2026-11-30T23:59:59-06:00">
  <div class="nyr-bf-top">
    <p class="nyr-bf-title">Black Friday<br>Sale</p>
    <div class="nyr-bf-off">
      <span class="nyr-bf-upto">UP TO</span>
      {%- if bf_img != blank -%}<img src="{{ bf_img }}" alt="Sale discount" width="140" loading="eager">{%- else -%}<b>50% OFF</b>{%- endif -%}
    </div>
  </div>
  <div class="nyr-bf-gift">
    <div class="nyr-bf-gift-img">{%- if bf_gift.featured_image -%}<img src="{{ bf_gift.featured_image | image_url: width: 120 }}" alt="The Hive – Handbook for parents" width="54" height="54" loading="lazy">{%- else -%}🎁{%- endif -%}</div>
    <div>
      <p class="nyr-bf-perk">Free Gift 🎁</p>
      <p class="nyr-bf-line">The Hive – Handbook for parents</p>
      <p class="nyr-bf-line">Free with your Busy Bee ($30 value)</p>
    </div>
  </div>
  <div class="nyr-bf-timer">
    <div class="nyr-bf-box"><b data-u="d">00</b><span>Days</span></div>
    <div class="nyr-bf-box"><b data-u="h">00</b><span>Hours</span></div>
    <div class="nyr-bf-box"><b data-u="m">00</b><span>Min</span></div>
    <div class="nyr-bf-box"><b data-u="s">00</b><span>Sec</span></div>
  </div>
</div>
<script>
(function(){
  function pad(n){return (n<10?'0':'')+n}
  function tick(){
    var els=document.querySelectorAll('.nyr-bf[data-end]');
    for(var i=0;i<els.length;i++){
      var el=els[i];
      var left=new Date(el.getAttribute('data-end')).getTime()-Date.now();
      if(!(left>0)){el.style.display='none';continue}
      var s=Math.floor(left/1000);
      var v={d:Math.floor(s/86400),h:Math.floor(s%86400/3600),m:Math.floor(s%3600/60),s:s%60};
      for(var k in v){var b=el.querySelector('[data-u="'+k+'"]');if(b)b.textContent=pad(v[k])}
    }
  }
  tick();
  if(!window.__nyrBfTimer){window.__nyrBfTimer=setInterval(tick,1000)}
})();
</script>
