{%- comment -%} Small countdown banner under "Your cart". Counts down to the real end of the Black Friday deal, then hides itself. {%- endcomment -%}
<style>
.nyr-ct{display:flex;align-items:center;justify-content:center;gap:6px;margin:0 0 10px;padding:8px 12px;background:#dcefff;border:1px solid #b9dcf8;border-radius:8px;color:#1f4e79;font-size:13px;font-weight:600;line-height:1.3;text-align:center}
.nyr-ct b{font-variant-numeric:tabular-nums;font-weight:800;color:#163d61}
</style>
<div class="nyr-ct" data-end="2026-11-30T23:59:59-06:00" role="timer" aria-live="off">
  <span>⏰ Black Friday prices end in <b class="nyr-ct-t">--</b></span>
</div>
<script>
(function(){
  if(window.__nyrCt)return;window.__nyrCt=1;
  function pad(n){return (n<10?'0':'')+n}
  function tick(){
    var els=document.querySelectorAll('.nyr-ct[data-end]');
    for(var i=0;i<els.length;i++){
      var el=els[i],left=new Date(el.getAttribute('data-end')).getTime()-Date.now();
      if(!(left>0)){el.style.display='none';continue}
      var s=Math.floor(left/1000),d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60),sec=s%60;
      var t=el.querySelector('.nyr-ct-t');
      if(t)t.textContent=(d>0?d+'d ':'')+pad(h)+':'+pad(m)+':'+pad(sec);
    }
  }
  tick();setInterval(tick,1000);
})();
</script>
