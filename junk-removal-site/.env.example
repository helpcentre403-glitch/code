# Copy this file to .env for local use. Never commit .env.
# On Cloudflare Pages / Netlify, set these in the dashboard instead (see README).
# All values below are PLACEHOLDERS.

# ---------- Site (build time) ----------
SITE_URL=https://example.com
# Meta Pixel ID (digits only). Leave empty to turn the pixel off.
META_PIXEL_ID=

# ---------- Where leads are saved ----------
# sheets  = Google Sheet in your Google account (the production default)
# webhook = POST JSON to an endpoint you run (e.g. your own database API)
# local   = files in ./data (local development only)
LEAD_STORE=local

# Google Sheets (LEAD_STORE=sheets)
GOOGLE_SHEET_ID=your-sheet-id-from-the-sheet-url
GOOGLE_SERVICE_ACCOUNT_EMAIL=lead-writer@your-project.iam.gserviceaccount.com
# Paste the private_key from the service account JSON, keeping the \n sequences, in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# Optional: Google Drive folder ID for uploaded photos (must be in a Shared Drive; see README).
GOOGLE_DRIVE_FOLDER_ID=

# Webhook (LEAD_STORE=webhook)
LEAD_WEBHOOK_URL=https://your-server.example.com/leads
LEAD_WEBHOOK_SECRET=replace-with-a-long-random-string
