# Copy this file to .env for local use. Never commit .env.
# On Netlify / Cloudflare Pages, set these in the dashboard instead (see README).
# All values below are PLACEHOLDERS.

# ---------- Site (build time) ----------
SITE_URL=https://example.com
# Meta Pixel ID (digits only). Leave empty to turn the pixel off.
META_PIXEL_ID=

# ---------- Where leads are saved ----------
# sheets  = Google Sheet in your Google account (default in production)
# webhook = POST JSON to an endpoint you run (e.g. your own database API)
# local   = files in ./data (local development only)
# Production: set LEAD_STORE=sheets (or leave it unset; sheets is the production default).
LEAD_STORE=local

# Google Sheets (LEAD_STORE=sheets)
GOOGLE_SHEET_ID=your-sheet-id-from-the-sheet-url
GOOGLE_SERVICE_ACCOUNT_EMAIL=lead-writer@your-project.iam.gserviceaccount.com
# Paste the private_key from the service account JSON, keeping the \n sequences, in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# Optional: Google Drive folder ID for uploaded photos (must be in a Shared Drive; see README).
GOOGLE_DRIVE_FOLDER_ID=

# Webhook (LEAD_STORE=webhook)
LEAD_WEBHOOK_URL=https://your-server.example.com/leads
LEAD_WEBHOOK_SECRET=replace-with-a-long-random-string

# ---------- Texting (Twilio, your own account) ----------
# live = really send texts; log = print texts instead of sending.
# Production: set SMS_MODE=live (or leave it unset; live is the production default).
SMS_MODE=log
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
# Use EITHER a sending number OR a Messaging Service SID.
TWILIO_FROM_NUMBER=+12145550100
TWILIO_MESSAGING_SERVICE_SID=
# The exact public URL Twilio calls for incoming texts (used to verify Twilio's signature).
TWILIO_WEBHOOK_URL=https://example.com/api/sms-inbound

# ---------- Owner alerts ----------
# Your cell phone. Gets a text for every new lead, plus forwarded customer texts.
OWNER_ALERT_PHONE=+12145550199
